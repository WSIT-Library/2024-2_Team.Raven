<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="192dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 앨범 사진 -->
                <ImageView
                    android:id="@+id/albumCover"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginLeft="-130dp"
                    android:layout_marginBottom="-80dp"
                    android:visibility="visible"
                    app:srcCompat="@drawable/ic_launcher_foreground"
                    tools:src="@tools:sample/backgrounds/scenic" />

                <!-- 노래 제목 -->
                <TextView
                    android:id="@+id/songTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Song Title"
                    android:textSize="20sp" />

                <!-- 아티스트 이름 -->
                <TextView
                    android:id="@+id/artistName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Artist Name"
                    android:textSize="16sp" />


                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- 경과 시간 -->
                    <TextView
                        android:id="@+id/currentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="00:00" />

                    <!-- 총 시간 -->
                    <TextView
                        android:id="@+id/totalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="03:30" />
                </LinearLayout>


            </LinearLayout>



            <!-- 중간 섹션 - 내부 및 외부 공기 질 및 온도 (이미지 및 분할선 포함) -->
            <LinearLayout
                android:id="@+id/environment_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- 내부 섹션 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/air_quality_inside_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="차량 내 공기질"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <!-- 내부 공기질 -->
                    <TextView
                        android:id="@+id/air_quality_Inside_label2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Air Quality (Inside)"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/air_quality_inside"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good"
                        android:textSize="14sp" />

                    <!-- 가로 분할선 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#CCCCCC" />

                    <!-- 내부 온도 -->


                    <TextView
                        android:id="@+id/temperature_Inside"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="차량 내 온도"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="match_parent"
                        android:layout_height="127dp"
                        android:src="@drawable/sun12" />

                    <TextView
                        android:id="@+id/temperature_Outside2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28°C"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- 분할선 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#CCCCCC" />

                <!-- 외부 섹션 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/air_quality_Outside_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="외부 공기질"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        />
                    <!-- 외부 공기질 -->
                    <TextView
                        android:id="@+id/air_quality_Outside_label2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Air Quality (Outside)"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/air_quality_outside"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moderate"
                        android:textSize="14sp" />

                    <!-- 가로 분할선 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginVertical="8dp" />

                    <!-- 외부 온도 -->
                    <ImageView
                        android:id="@+id/temperature_outside_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/temperature_Outside"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="외부 온도"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        />

                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="match_parent"
                        android:layout_height="127dp"
                        android:src="@drawable/clou" />

                    <TextView
                        android:id="@+id/textViewTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22°C"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textViewLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="19dp"
                        android:layout_marginTop="16dp"
                        android:text="현재 위치를 가져오는 중..." />

                </LinearLayout>
            </LinearLayout>
            <!-- 밝기 조절 SeekBar -->
            <SeekBar
                android:id="@+id/brightnessSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <!-- 심박수 체크 섹션 -->
            <TextView
                android:id="@+id/heartRateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 심박수"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="32dp"/>

            <TextView
                android:id="@+id/textViewReceive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heart Rate: -- BPM"
                android:textSize="18sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="8dp"/>

            <!-- 공기질 관리 섹션 -->
            <TextView
                android:id="@+id/airQualityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="조명 밝기"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="32dp"/>

            <TextView
                android:id="@+id/airQualityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Air Quality: Good"
                android:textSize="18sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:text="오늘은 평소보다 심박수가 2bpm가량 높아요."
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"
                />



        </LinearLayout>
    </ScrollView>


</RelativeLayout>


